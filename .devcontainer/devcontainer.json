{
  "name": "spend-tracker (FastAPI + SQLite)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [8766],
  "portsAttributes": {
    "8766": {
      "label": "spendtrack",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && $HOME/.local/bin/uv sync",
  "postStartCommand": "nohup bash -c \"$HOME/.local/bin/uv sync && exec $HOME/.local/bin/uv run uvicorn spendtrack.main:app --host 0.0.0.0 --port 8766\" > /tmp/spendtrack.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}
