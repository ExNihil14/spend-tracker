# Скопируй в .env в корне репозитория: cp .env.example .env
# Приложение читает .env при старте; переменные окружения имеют приоритет.
# Провайдеры по умолчанию — в config/settings.toml.

# FreeLLMAPI (основной, localhost:3001) — тот же ключ, что в opencode.json
SPENDTRACK_FREEL_LLM_API_KEY=

# OpenRouter (fallback) — для :free моделей
SPENDTRACK_OPENROUTER_API_KEY=sk-or-вставь_свой

# Необязательно: иной путь БД (по умолчанию data/spend.db)
# SPENDTRACK_DB_PATH=D:\data\personal\receipts\spend.db