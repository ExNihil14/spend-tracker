# Скопируй в .env в корне репозитория: cp .env.example .env
# Приложение читает .env при старте; переменные окружения имеют приоритет.
# Провайдеры free-цепочки по умолчанию — в config/settings.toml.

# === Свой LLM (BYO/Ollama) — рекомендуется: полный контроль над данными ===
# Любой OpenAI-совместимый сервер (OpenAI, Groq, LM Studio, vLLM...):
# SPENDTRACK_LLM_BASE_URL=https://api.openai.com/v1
# SPENDTRACK_LLM_MODEL=gpt-4o-mini
# SPENDTRACK_LLM_API_KEY=sk-...
# Или локальный Ollama (без ключа, данные не покидают машину; сначала `ollama pull qwen2.5-coder:3b`):
# SPENDTRACK_LLM_PROVIDER=ollama
# SPENDTRACK_LLM_MODEL=qwen2.5-coder:3b

# === Free-каналы — осознанный opt-in (данные уходят внешним сервисам) ===
# OpenRouter — бесплатные :free модели
SPENDTRACK_OPENROUTER_API_KEY=sk-or-вставь_свой
# FreeLLMAPI (локальный шим, localhost:3001) — требует SPENDTRACK_ALLOW_LOCAL_LLM=1
SPENDTRACK_FREEL_LLM_API_KEY=

# Необязательно: иной путь БД (по умолчанию data/spend.db)
# SPENDTRACK_DB_PATH=D:\data\personal\receipts\spend.db
